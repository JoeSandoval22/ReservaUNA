<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color:#DB3C1A;"
    xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="cr.ac.una.reservauna.controller.HandleStatusController">
  <children>

    <Label layoutX="20.0" layoutY="16.0"
           style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:white;"
           text="Aprobar / Rechazar Reservas" />
    <Button fx:id="btnRegresar" layoutX="790.0" layoutY="16.0" prefWidth="90.0" prefHeight="32.0"
            onAction="#BtnRegresar"
            style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;"
            text="Regresar" />

    <Label layoutX="20.0" layoutY="58.0" style="-fx-text-fill:white;-fx-font-weight:bold;" text="Filtros de búsqueda" />
    <ComboBox fx:id="cmbFiltroEstado" layoutX="20.0" layoutY="78.0" prefWidth="140.0" prefHeight="32.0" />
    <DatePicker fx:id="dpFecha" layoutX="175.0" layoutY="78.0" prefWidth="160.0" prefHeight="32.0" promptText="Fecha" />
    <TextField fx:id="txtBuscarUsuario" layoutX="350.0" layoutY="78.0" prefWidth="180.0" prefHeight="32.0" promptText="Filtrar usuario..." />
    <Button layoutX="545.0" layoutY="78.0" prefWidth="90.0" prefHeight="32.0"
            onAction="#BtnBuscar"
            style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;"
            text="Buscar" />

    <TableView fx:id="tblReservas" layoutX="20.0" layoutY="124.0" prefHeight="240.0" prefWidth="860.0">
      <columns>
        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
        <TableColumn fx:id="colUsuario" prefWidth="150.0" text="Usuario" />
        <TableColumn fx:id="colRecurso" prefWidth="160.0" text="Recurso" />
        <TableColumn fx:id="colInicio" prefWidth="130.0" text="Fecha inicio" />
        <TableColumn fx:id="colFin" prefWidth="130.0" text="Fecha final" />
        <TableColumn fx:id="colMotivo" prefWidth="120.0" text="Motivo" />
        <TableColumn fx:id="colEstado" prefWidth="118.0" text="Estado" />
      </columns>
    </TableView>

    <Label fx:id="lblReservaSeleccionada" layoutX="20.0" layoutY="376.0"
           style="-fx-text-fill:#ffe0d0;-fx-font-size:12px;" />

    <Label layoutX="20.0" layoutY="396.0" style="-fx-text-fill:white;-fx-font-weight:bold;" text="Motivo de aprobación o rechazo *" />
    <TextArea fx:id="txtMotivo" layoutX="20.0" layoutY="416.0" prefHeight="100.0" prefWidth="860.0"
              promptText="Ingrese el motivo..." />

    <Label fx:id="lblMensaje" layoutX="20.0" layoutY="526.0"
           style="-fx-font-size:11px;-fx-text-fill:#ffe0d0;" />

    <!-- BOTONES -->
    <Button fx:id="btnAprobar" layoutX="20.0" layoutY="556.0" prefWidth="140.0" prefHeight="36.0"
            onAction="#BtnAprobar"
            style="-fx-background-color:#2a902a;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;"
            text="Aprobar" />
    <Button fx:id="btnRechazar" layoutX="175.0" layoutY="556.0" prefWidth="140.0" prefHeight="36.0"
            onAction="#BtnRechazar"
            style="-fx-background-color:#c0392b;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;"
            text="Rechazar" />

  </children>
</AnchorPane>