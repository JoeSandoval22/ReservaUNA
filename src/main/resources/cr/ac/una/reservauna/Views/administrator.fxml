<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="620.0" prefWidth="900.0" style="-fx-background-color: #8B1A1A;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.reservauna.controller.AdministratorGUI">
    <children>
        <HBox layoutX="0.0" layoutY="0.0" prefHeight="70.0" prefWidth="900.0" style="-fx-background-color:#7A1515;                      -fx-border-color:#FFD700;                      -fx-border-width:0 0 3 0;                      -fx-padding:10 20 10 20;                      -fx-alignment:CENTER_LEFT;                      -fx-spacing:14;">
            <children>
                <ImageView fitHeight="48.0" fitWidth="48.0" preserveRatio="true">
                    <image>
                        <Image url="@/Image/logo_universidad_nacional_de_costa_rica.png" />
                    </image>
                </ImageView>
                <VBox spacing="2">
                    <children>
                        <Label style="-fx-text-fill:white;                                       -fx-font-size:20px;                                       -fx-font-weight:bold;" text="ReservaUNA" />
                        <Label style="-fx-text-fill:rgba(255,255,255,0.75);                                       -fx-font-size:11px;" text="Sistema de reservas de espacios y equipos" />
                    </children>
                </VBox>
                <HBox HBox.hgrow="ALWAYS" />
                <VBox spacing="2" style="-fx-alignment:CENTER_RIGHT;">
                    <children>
                        <Label fx:id="LabelNombre" style="-fx-text-fill:white;                                       -fx-font-size:13px;                                       -fx-font-weight:bold;" />
                        <Label fx:id="LabelCorreo" style="-fx-text-fill:rgba(255,255,255,0.70);                                       -fx-font-size:11px;" />
                    </children>
                </VBox>
                <Button fx:id="logOutButton" onAction="#switchToLogin" style="-fx-background-color:#FFD700;                                -fx-text-fill:#4A2800;                                -fx-font-weight:bold;                                -fx-background-radius:6;" text="Cerrar sesión" />
            </children>
        </HBox>
        <HBox layoutX="20.0" layoutY="78.0" spacing="10.0" />
        <HBox layoutX="20.0" layoutY="160.0" spacing="12.0">
            <children>
                <VBox prefWidth="220.0" spacing="8.0" style="-fx-background-color:white;                              -fx-background-radius:10;                              -fx-padding:12;">
                    <children>
                        <Label style="-fx-font-size:13px;                                       -fx-font-weight:bold;                                       -fx-text-fill:#555;                                       -fx-border-color:#F0EBE3;                                       -fx-border-width:0 0 1 0;                                       -fx-padding:0 0 8 0;" text="Accesos rápidos" />
                        <Button fx:id="reservesButton" onAction="#switchToReserves" prefWidth="190.0" style="-fx-background-color:#8B1A1A;                                        -fx-text-fill:white;                                        -fx-font-weight:bold;                                        -fx-background-radius:6;" text="+ Nueva reserva" />
                        <Button fx:id="usersButton" onAction="#switchToUsersHandle" prefWidth="190.0" style="-fx-background-color:#F4F1EC;                                        -fx-text-fill:#333;                                        -fx-background-radius:6;                                        -fx-border-color:#E0D8CE;                                        -fx-border-radius:6;" text="Gestor de usuarios" />
                        <Button fx:id="placesGestor" onAction="#switchToPlaces" prefWidth="190.0" style="-fx-background-color:#F4F1EC;                                        -fx-text-fill:#333;                                        -fx-background-radius:6;                                        -fx-border-color:#E0D8CE;                                        -fx-border-radius:6;" text="Gestor de lugares" />
                        <Button fx:id="equipmentGestor" onAction="#switchToEquipments" prefWidth="190.0" style="-fx-background-color:#F4F1EC;                                        -fx-text-fill:#333;                                        -fx-background-radius:6;                                        -fx-border-color:#E0D8CE;                                        -fx-border-radius:6;" text="Gestor de equipos" />
                        <Button fx:id="reservesGestorButton" onAction="#switchToReservesGestor" prefWidth="190.0" style="-fx-background-color:#F4F1EC;                                        -fx-text-fill:#333;                                        -fx-background-radius:6;                                        -fx-border-color:#E0D8CE;                                        -fx-border-radius:6;" text="Gestor de reservas" />
                        <Button fx:id="logsButton" onAction="#switchToLogsHandle" prefWidth="190.0" style="-fx-background-color:#F4F1EC;                                        -fx-text-fill:#333;                                        -fx-background-radius:6;                                        -fx-border-color:#E0D8CE;                                        -fx-border-radius:6;" text="Ver bitácoras" />
                    </children>
                </VBox>
                <VBox prefWidth="648.0" spacing="8.0" style="-fx-background-color:white;                              -fx-background-radius:10;                              -fx-padding:12;">
                    <children>
                        <Label style="-fx-font-size:13px;                                       -fx-font-weight:bold;                                       -fx-text-fill:#555;                                       -fx-border-color:#F0EBE3;                                       -fx-border-width:0 0 1 0;                                       -fx-padding:0 0 8 0;" text="Reservas recientes" />
                        <TableView fx:id="TablaReservas" prefHeight="395.0" prefWidth="620.0">
                            <columns>
                                <TableColumn fx:id="colRecurso" prefWidth="206.0" text="Recurso" />
                                <TableColumn fx:id="colFecha" prefWidth="206.0" text="Fecha" />
                                <TableColumn fx:id="colEstado" prefWidth="206.0" text="Estado" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>
