<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: #8B1A1A;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.reservauna.controller.PlaceController">
  <children>

    <Label layoutX="20.0" layoutY="16.0" style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:white;" text="Gestión de Recursos (Lugares)" />
    <Button fx:id="backButton" layoutX="790.0" layoutY="16.0" onAction="#backToAdmin" prefHeight="32.0" prefWidth="90.0" style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;" text="Regresar" />

    <TextField fx:id="idtext" layoutX="20.0" layoutY="68.0" prefHeight="32.0" prefWidth="200.0" promptText="Buscar por ID" />
    <Button fx:id="searchButton" layoutX="232.0" layoutY="68.0" onAction="#searchPlace" prefHeight="32.0" prefWidth="90.0" style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;" text="Buscar" />
    <Button fx:id="showButton" layoutX="337.0" layoutY="68.0" onAction="#showPlaces" prefHeight="32.0" prefWidth="150.0" style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;" text="Mostrar lugares" />

    <TableView fx:id="placesList" layoutX="20.0" layoutY="114.0" prefHeight="230.0" prefWidth="860.0">
      <columns>
        <TableColumn fx:id="idColumn" prefWidth="80.0" text="ID recurso" />
        <TableColumn fx:id="nameColumn" prefWidth="160.0" text="Nombre" />
        <TableColumn fx:id="capacityColumn" prefWidth="90.0" text="Capacidad" />
        <TableColumn fx:id="locationColumn" prefWidth="150.0" text="Ubicación" />
        <TableColumn fx:id="typeColumn" prefWidth="110.0" text="Tipo" />
        <TableColumn fx:id="stateColumn" prefWidth="100.0" text="Estado" />
        <TableColumn fx:id="descriptionColumn" prefWidth="168.0" text="Descripción" />
      </columns>
    </TableView>

    <Label layoutX="20.0" layoutY="358.0" style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:white;" text="Detalle del espacio" />

    <Label layoutX="20.0" layoutY="386.0" style="-fx-text-fill:white;" text="Nombre de recurso" />
    <TextField fx:id="nameText" layoutX="20.0" layoutY="404.0" prefHeight="32.0" prefWidth="260.0" />

    <Label layoutX="300.0" layoutY="386.0" style="-fx-text-fill:white;" text="Capacidad" />
    <TextField fx:id="capacityText" layoutX="300.0" layoutY="404.0" prefHeight="32.0" prefWidth="260.0" />

    <Label layoutX="20.0" layoutY="448.0" style="-fx-text-fill:white;" text="Ubicación" />
    <TextField fx:id="locationText" layoutX="20.0" layoutY="466.0" prefHeight="32.0" prefWidth="260.0" />

    <Label layoutX="300.0" layoutY="448.0" style="-fx-text-fill:white;" text="Tipo de recurso" />
    <ComboBox fx:id="typeCombo" layoutX="300.0" layoutY="466.0" prefHeight="32.0" prefWidth="260.0" />

    <Label layoutX="20.0" layoutY="510.0" style="-fx-text-fill:white;" text="Estado del recurso" />
    <ComboBox fx:id="stateCombo" layoutX="20.0" layoutY="528.0" prefHeight="32.0" prefWidth="260.0" />

    <Label layoutX="300.0" layoutY="510.0" style="-fx-text-fill:white;" text="Descripción" />
    <TextField fx:id="descriptionText" layoutX="300.0" layoutY="528.0" prefHeight="32.0" prefWidth="260.0" />

    <Label layoutX="580.0" layoutY="510.0" style="-fx-text-fill:white;" text="ID recurso (solo actualizar)" />
    <TextField fx:id="idUpdateText" layoutX="580.0" layoutY="528.0" prefHeight="32.0" prefWidth="200.0" />

    <Label fx:id="lblMensaje" layoutX="20.0" layoutY="572.0" style="-fx-font-size:11px;-fx-text-fill:#ffe0d0;" text="" />

    <Button fx:id="addButton" layoutX="20.0" layoutY="600.0" onAction="#addPlace" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color:#2a902a;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;" text="+ Nuevo recurso" />
    <Button fx:id="updateButton" layoutX="175.0" layoutY="600.0" onAction="#updatePlaces" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color:#2a70b0;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;" text="Actualizar recurso" />
    <Button fx:id="deleteButton" layoutX="330.0" layoutY="600.0" onAction="#deletePlaces" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color:#c0392b;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;" text="Eliminar recurso" />
    <Button fx:id="clearButton" layoutX="485.0" layoutY="600.0" onAction="#clearFields" prefHeight="36.0" prefWidth="100.0" style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;" text="Limpiar" />

  </children>
</AnchorPane>
