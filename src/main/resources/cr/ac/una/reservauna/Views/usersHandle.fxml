<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color:#DB3C1A;"
    xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="cr.ac.una.reservauna.controller.HandleUserController">
  <children>

    <Label layoutX="20.0" layoutY="16.0"
           style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:white;"
           text="Gestión de Usuarios" />

    <TextField fx:id="txtBuscar" layoutX="20.0" layoutY="60.0" prefWidth="200.0" prefHeight="32.0"
               promptText="Buscar nombre o correo..." />
    <ComboBox fx:id="cmbFiltroRol" layoutX="235.0" layoutY="60.0" prefWidth="140.0" prefHeight="32.0" />
    <ComboBox fx:id="cmbFiltroEstado" layoutX="390.0" layoutY="60.0" prefWidth="120.0" prefHeight="32.0" />
    <Button layoutX="525.0" layoutY="60.0" prefWidth="90.0" prefHeight="32.0"
            onAction="#BtnBuscar"
            style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;"
            text="Buscar" />
    <Button fx:id="btnNuevo" layoutX="630.0" layoutY="60.0" prefWidth="130.0" prefHeight="32.0"
            onAction="#BtnNuevo"
            style="-fx-background-color:#2a902a;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;"
            text="+ Nuevo usuario" />
    <Button fx:id="btnRegresar" layoutX="775.0" layoutY="60.0" prefWidth="90.0" prefHeight="32.0"
            onAction="#BtnRegresar"
            style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;"
            text="Regresar" />

    <TableView fx:id="tblUsuarios" layoutX="20.0" layoutY="106.0" prefHeight="230.0" prefWidth="860.0">
      <columns>
        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
        <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
        <TableColumn fx:id="colCorreo" prefWidth="200.0" text="Correo" />
        <TableColumn fx:id="colRol" prefWidth="150.0" text="Rol" />
        <TableColumn fx:id="colMax" prefWidth="100.0" text="Máx. reservas" />
        <TableColumn fx:id="colEstado" prefWidth="168.0" text="Estado" />
      </columns>
    </TableView>

    <Label layoutX="20.0" layoutY="352.0"
           style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:white;"
           text="Detalle del usuario" />

    <Label layoutX="20.0" layoutY="380.0" style="-fx-text-fill:white;" text="Nombre *" />
    <TextField fx:id="txtNombre" layoutX="20.0" layoutY="398.0" prefWidth="280.0" prefHeight="32.0" />

    <Label layoutX="320.0" layoutY="380.0" style="-fx-text-fill:white;" text="Correo *" />
    <TextField fx:id="txtCorreo" layoutX="320.0" layoutY="398.0" prefWidth="280.0" prefHeight="32.0" />

    <Label layoutX="20.0" layoutY="444.0" style="-fx-text-fill:white;" text="Rol *" />
    <ComboBox fx:id="cmbRol" layoutX="20.0" layoutY="462.0" prefWidth="280.0" prefHeight="32.0" />

    <Label layoutX="320.0" layoutY="444.0" style="-fx-text-fill:white;" text="Estado *" />
    <ComboBox fx:id="cmbEstado" layoutX="320.0" layoutY="462.0" prefWidth="280.0" prefHeight="32.0" />

    <Label fx:id="lblMensaje" layoutX="20.0" layoutY="508.0"
           style="-fx-font-size:11px;-fx-text-fill:#ffe0d0;" text="" />

    <Button fx:id="btnGuardar" layoutX="20.0" layoutY="536.0" prefWidth="120.0" prefHeight="36.0"
            onAction="#BtnGuardar"
            style="-fx-background-color:#2a70b0;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;"
            text="Guardar" />
    <Button fx:id="btnInactivar" layoutX="155.0" layoutY="536.0" prefWidth="120.0" prefHeight="36.0"
            onAction="#BtnInactivar"
            style="-fx-background-color:#c0392b;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;"
            text="Inactivar" />
    <Button fx:id="btnLimpiar" layoutX="290.0" layoutY="536.0" prefWidth="100.0" prefHeight="36.0"
            onAction="#BtnLimpiar"
            style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;"
            text="Limpiar" />

  </children>
</AnchorPane>