<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color:#DB3C1A;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.reservauna.controller.HandleUserController">
  <children>

    <Label layoutX="20.0" layoutY="16.0" style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:white;" text="Gestión de Usuarios" />

    <TextField fx:id="idText" layoutX="20.0" layoutY="60.0" prefHeight="32.0" prefWidth="200.0" promptText="Buscar nombre o correo..." />
    <Button fx:id="searchButton" layoutX="274.0" layoutY="60.0" onAction="#searchUser" prefHeight="32.0" prefWidth="90.0" style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;" text="Buscar" />
    <Button fx:id="backButton" layoutX="775.0" layoutY="60.0" onAction="#backTo" prefHeight="32.0" prefWidth="90.0" style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;" text="Regresar" />

    <TableView fx:id="usersList" layoutX="20.0" layoutY="106.0" prefHeight="230.0" prefWidth="860.0">
      <columns>
        <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
        <TableColumn fx:id="nameColumn" prefWidth="180.0" text="Nombre" />
        <TableColumn fx:id="emailColumn" prefWidth="200.0" text="Correo" />
        <TableColumn fx:id="roleColumn" prefWidth="150.0" text="Rol" />
        <TableColumn fx:id="userMaxReserves" prefWidth="100.0" text="Máx. reservas" />
        <TableColumn fx:id="stateColumn" prefWidth="168.0" text="Estado" />
      </columns>
    </TableView>

    <Label layoutX="20.0" layoutY="352.0" style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:white;" text="Detalle del usuario" />

    <Label layoutX="20.0" layoutY="444.0" style="-fx-text-fill:white;" text="Nombre *" />
    <TextField fx:id="idUpdateText" layoutX="20.0" layoutY="398.0" prefHeight="32.0" prefWidth="280.0" />

    <Label layoutX="320.0" layoutY="380.0" style="-fx-text-fill:white;" text="Correo *" />
    <TextField fx:id="emailText" layoutX="320.0" layoutY="398.0" prefHeight="32.0" prefWidth="280.0" />

    <Label layoutX="320.0" layoutY="500.0" style="-fx-text-fill:white;" text="Rol *" />
    <ComboBox fx:id="roleCombo" layoutX="320.0" layoutY="516.0" prefHeight="32.0" prefWidth="280.0" />

    <Label layoutX="320.0" layoutY="444.0" style="-fx-text-fill:white;" text="Estado *" />
    <ComboBox fx:id="userStateCombo" layoutX="320.0" layoutY="462.0" prefHeight="32.0" prefWidth="280.0" />

    <Label fx:id="lblMensaje" layoutX="20.0" layoutY="508.0" style="-fx-font-size:11px;-fx-text-fill:#ffe0d0;" text="" />

    <Button fx:id="updateButton" layoutX="634.0" layoutY="396.0" onAction="#updateUsers" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color:#2a70b0;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;" text="Actualizar usuario" />
    <Button fx:id="clearButton" layoutX="634.0" layoutY="460.0" onAction="#clearFields" prefHeight="36.0" prefWidth="100.0" style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;" text="Limpiar" />
      <Button fx:id="showButton" layoutX="414.0" layoutY="64.0" mnemonicParsing="false" onAction="#showUsers" text="Mostrar usuarios" />
      <TextField fx:id="nameText" layoutX="20.0" layoutY="462.0" prefHeight="32.0" prefWidth="280.0" />
      <Label layoutX="19.0" layoutY="380.0" text="ID de usuario " textFill="WHITE" />
      <Label layoutX="20.0" layoutY="500.0" text="Nueva contraseña*" textFill="WHITE" />
      <TextField fx:id="passwordText" layoutX="20.0" layoutY="516.0" prefHeight="32.0" prefWidth="280.0" />
      <Button fx:id="deleteButton" layoutX="558.0" layoutY="64.0" mnemonicParsing="false" onAction="#deleteUsers" text="Eliminar usuario" />

  </children>
</AnchorPane>
