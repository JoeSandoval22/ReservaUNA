    <Button fx:id="btnMisReservas2" layoutX="580.0" layoutY="418.0" onAction="#btnIngresarMisReservas2" prefHeight="34.0" prefWidth="290.0" style="-fx-background-color:#DB9E1A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:6;" text="Mis reservas" />

